# =================================================================
# EarthSage AI — Environment Configuration Template
# Copy this file to .env and configure local parameters.
# DO NOT commit .env with actual secrets to version control.
# =================================================================

# --- Database Configuration ---
POSTGRES_DB=earthsage
POSTGRES_USER=earthsage_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5439

# PostgreSQL connection string for backend container:
DATABASE_URL=postgresql+psycopg://earthsage_user:your_secure_postgres_password_here@postgres:5439/earthsage

# --- NASA POWER Meteorological API ---
# NASA POWER monthly point API requires no authentication token.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/monthly/point
NASA_POWER_TIMEOUT=30.0

# --- JWT Authentication & Session Security ---
# Secret key used for signing JWT access tokens (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=earthsage-jwt-secret-key-development-mode-2026-secure-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=earthsage_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# --- Gemini AI Research Assistant (Optional) ---
# Supported providers: "none" (default, disables AI gracefully), "gemini"
AI_PROVIDER=none

# Gemini API Key (keep backend-only; leave blank if AI_PROVIDER=none)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: currently supported free-tier model)
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:8020

# CARTO Basemap API Key (Free tier up to 5M tile requests/month at https://carto.com/basemaps/apikey/)
# When configured, loads CARTO Light All (Positron) without watermarks.
# When omitted, the frontend automatically falls back to OpenStreetMap so watermarks never appear.
VITE_CARTO_API_KEY=

