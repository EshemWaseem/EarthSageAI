# =============================================================================
# EarthSage AI — Production Environment Configuration Template
# Instructions: Copy this file to .env.production on your production server.
# Fill in real credentials and domain names. NEVER commit .env.production to git.
# =============================================================================

# --- Production Domain & SSL (Let's Encrypt / ZeroSSL) ---
# Replace with your actual fully qualified domain name (e.g., earthsage.yourdomain.org)
# Or leave as "localhost" for local staging / IP testing
DOMAIN=earthsage.example.org
ACME_EMAIL=admin@example.org

# --- Production Database (PostgreSQL 16) ---
# Generated strong passwords should be at least 24 characters
POSTGRES_DB=earthsage
POSTGRES_USER=earthsage_user
POSTGRES_PASSWORD=replace_with_a_secure_random_production_password_here

# --- Production Security & CORS ---
# Specify comma-separated list of allowed frontend origins, or "*"
CORS_ORIGINS=https://earthsage.example.org,http://localhost
SHOW_DOCS=true

# --- NASA POWER API Configuration ---
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/monthly/point
NASA_POWER_TIMEOUT=30.0

# --- JWT Authentication & Session Security ---
# In production, generate a secure random 64-character secret (openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=earthsage_refresh_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# --- Google Gemini AI Research Assistant (Optional) ---
# Default is "none". When inactive, EarthSage operates with 100% functionality
# using its verified deterministic rule-based scientific planner and interpreter.
# To enable Gemini:
#   1. Set AI_PROVIDER=gemini
#   2. Provide your GEMINI_API_KEY (stored strictly on backend, never sent to browser)
#   3. Select model (e.g., gemini-3.8-flash, gemini-2.5-flash)
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

