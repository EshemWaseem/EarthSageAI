

# --- Production Domain & SSL (Let's Encrypt / ZeroSSL) ---
#  your actual fully qualified domain name (e.g., earthsage.yourdomain.org)
# Or leave as "localhost" for local staging / IP testing
DOMAIN=earthsage.example.org
ACME_EMAIL=admin@example.org

# --- Production Database (PostgreSQL 16) ---
# Generated strong passwords should be at least 24 characters
POSTGRES_DB=earthsage
POSTGRES_USER=earthsage_user
POSTGRES_PASSWORD=replace_with_a_secure_random_production_password_here

# --- Production Security & CORS ---
# Specify comma-separated list of allowed frontend origins, or "*"
CORS_ORIGINS=https://earthsage.example.org,http://localhost
SHOW_DOCS=true

# --- NASA POWER API Configuration ---
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/monthly/point
NASA_POWER_TIMEOUT=30.0

# --- JWT Authentication & Session Security ---

JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=earthsage_refresh_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# --- Google Gemini AI Research Assistant --
# Default is auto-detected. When GEMINI_API_KEY (or GOOGLE_API_KEY) is supplied,
# AI_PROVIDER is automatically set to "gemini". If no key is set or AI_PROVIDER=none,
# EarthSage operates with 100% full functionality using its verified deterministic
# non-parametric scientific planner and interpreter.
#
# Render Dashboard Instructions:
# Add either GEMINI_API_KEY or GOOGLE_API_KEY as an Environment Variable in Render:
#   GEMINI_API_KEY=--...
#   GEMINI_MODEL=gemini-3.8-flash 
#   AI_PROVIDER=gemini (optional, auto-detected when key is set)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Frontend Production Configuration (Vercel) ---

# VITE_API_URL=https://earthsageai.accc.com
# VITE_CARTO_API_KEY=your_carto_api_key_here
VITE_CARTO_API_KEY=

